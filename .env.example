# ===== PostgreSQL =====
POSTGRES_USER=twin_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=twin_db

# ===== Backend (FastAPI) =====
# Se arma automáticamente en docker-compose a partir de las variables de arriba.
# Solo necesario si corres el backend fuera de Docker:
# DATABASE_URL=postgresql+asyncpg://twin_user:change-me@localhost:5432/twin_db

JWT_SECRET_KEY=change-me-generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REDIS_URL=redis://localhost:6379/0

# API Key de Gemini (Paso 3 del prompt agéntico: motor de IA en el backend)
GEMINI_API_KEY=

# ===== Frontend (Next.js) =====
NEXT_PUBLIC_API_URL=http://localhost:8000
